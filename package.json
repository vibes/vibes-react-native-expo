{
  "name": "vibes-react-native-expo",
  "version": "5.0.0",
  "description": "Expo config plugin for Vibes Android & iOS SDK integration via vibes-react-native",
  "main": "build/index.js",
  "types": "build/index.d.ts",
  "scripts": {
    "build": "expo-module build",
    "clean": "expo-module clean",
    "lint": "expo-module lint",
    "test": "jest",
    "prepare": "expo-module prepare",
    "prepublishOnly": "expo-module prepublishOnly",
    "typescript": "expo-module typecheck && tsc --noEmit -p plugin/tsconfig.json"
  },
  "keywords": [
    "react-native",
    "expo",
    "vibes-react-native-expo",
    "VibesReactNativeExpo"
  ],
  "repository": "https://github.com/vibes/vibes-react-native-expo",
  "bugs": {
    "url": "https://github.com/vibes/vibes-react-native-expo/issues"
  },
  "author": "Vibes",
  "license": "MIT",
  "homepage": "https://github.com/vibes/vibes-react-native-expo#readme",
  "dependencies": {
    "@expo/config-plugins": "~9.0.17",
    "@types/fs-extra": "^11.0.4",
    "expo-dev-client": "~5.0.20",
    "fs-extra": "^11.3.2",
    "expo": "~52.0.49",
    "react": "18.3.1",
    "react-native": "0.76.9",
    "vibes-react-native": "5.0.0"
  },
  "devDependencies": {
    "@types/jest": "^29.5.14",
    "@types/react": "18.3.12",
    "expo": "52.0.49",
    "expo-module-scripts": "5.0.8",
    "jest": "^29.7.0",
    "react": "18.3.1",
    "react-native": "0.76.9",
    "ts-jest": "^29.2.5",
    "typescript": "~5.9.2"
  },
  "peerDependencies": {
    "expo": "*",
    "react": "*",
    "react-native": "*"
  }
}
